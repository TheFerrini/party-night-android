{
  "name": "party-night-android",
  "private": true,
  "version": "2.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "android:init": "cap add android && sh ./scripts/install-android-icons.sh",
    "android:sync": "npm run build && cap sync android && sh ./scripts/install-android-icons.sh",
    "android:open": "cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug && VERSION=$(grep -oE '[0-9]+\\.[0-9]+\\.[0-9]+' ../src/version.ts | head -1) && mv app/build/outputs/apk/debug/app-debug.apk \"app/build/outputs/apk/debug/Party Night-v${VERSION}.apk\""
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@supabase/supabase-js": "2.119.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.1.0"
  }
}
